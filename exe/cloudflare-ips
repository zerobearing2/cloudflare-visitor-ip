#!/usr/bin/env ruby
require_relative "../lib/cloudflare_visitor_ip"

ranges = case ARGV
in [] then CloudflareVisitorIp.ranges
in [ "--v4" ] then CloudflareVisitorIp.v4_ranges
in [ "--v6" ] then CloudflareVisitorIp.v6_ranges
else
  warn "Usage: cloudflare-ips [--v4|--v6]"
  exit 2
end

ranges.each { |range| puts "#{range}/#{range.prefix}" }
